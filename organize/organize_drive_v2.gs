  const t0=Date.now();
  const LIMIT=5*60*1000; // 5 min — pause before Drive kills us at 6
  let moved=0,errored=0,i=startIdx;
  for(;i<items.length;i++){
    if(Date.now()-t0>LIMIT){
      props.setProperty("idx",String(i));
      Logger.log("PAUSED at idx=%s/%s moved-this-run=%s errored=%s — click Run again to continue",i,items.length,moved,errored);
      return;
    }
    const it=items[i];
    try{
      const file=DriveApp.getFileById(it.id);
      let target;
      if(it.is_dup)target=getOrCreate(dupRoot,it.project||"Unknown");
      else if(it.project&&it.sub)target=getOrCreate(getOrCreate(org,it.project),it.sub);
      else if(it.project)target=getOrCreate(getOrCreate(org,it.project),"_NeedsReview");
      else if(it.sub)target=getOrCreate(lib,it.sub);
      else target=getOrCreate(org,"_NeedsReview");
      moveFile(file,target);
      moved++;
      if(moved%100===0)Logger.log("moved %s (now at idx %s)",moved,i);
    }catch(e){errored++;if(errored<=10)Logger.log("ERR idx=%s id=%s %s",i,it.id,e);}
  }
  props.setProperty("idx",String(i));
  Logger.log("DONE moved-this-run=%s errored=%s total=%s",moved,errored,items.length);
}
function resetProgress(){
  PropertiesService.getScriptProperties().deleteProperty("idx");
  Logger.log("progress reset — next run starts from idx 0");
}
function showProgress(){
  const idx=parseInt(PropertiesService.getScriptProperties().getProperty("idx")||"0",10);
  Logger.log("current idx=%s — files remaining to consider ≈ %s",idx,3322-idx);
}
