{
  "manifest_version": 3,
  "name": "Real Deal — One-click underwriting",
  "short_name": "Real Deal",
  "description": "Underwrite any Realtor.ca / Zillow / Redfin listing in one click. Pulls price, beds/baths/sqft from the page and opens the full analyzer.",
  "version": "1.0.0",
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title":  "Underwrite this listing in Real Deal",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://www.realtor.ca/*",
    "https://www.zillow.com/*",
    "https://www.redfin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.realtor.ca/*"],
      "js":      ["scrapers/realtor-ca.js", "scrapers/_shared.js"],
      "run_at":  "document_idle"
    },
    {
      "matches": ["https://www.zillow.com/*"],
      "js":      ["scrapers/zillow.js", "scrapers/_shared.js"],
      "run_at":  "document_idle"
    },
    {
      "matches": ["https://www.redfin.com/*"],
      "js":      ["scrapers/redfin.js", "scrapers/_shared.js"],
      "run_at":  "document_idle"
    }
  ]
}
